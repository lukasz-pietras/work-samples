        448,
        304
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const WINDOW_MIN = 60; // same workflow + node + message at most once per hour\nconst alert = $('Build alert').first().json;\nconst row = $input.all().map(i => i.json).find(r => r && r.alert_key === alert.alert_key);\nconst now = Date.now();\nconst last = row && row.last_sent ? Date.parse(row.last_sent) : NaN;\nconst suppressedBefore = row && row.suppressed ? Number(row.suppressed) : 0;\nconst withinWindow = !isNaN(last) && (now - last) < WINDOW_MIN * 60 * 1000;\nlet content = alert.content;\nif (!withinWindow && suppressedBefore > 0) {\n  content += '\\n_(+' + suppressedBefore + ' takich samych błędów pominiętych od poprzedniego powiadomienia)_';\n}\nreturn [{ json: {\n  send: !withinWindow,\n  alert_key: alert.alert_key,\n  workflow_id: alert.workflow_id,\n  content,\n  last_sent: withinWindow ? row.last_sent : new Date(now).toISOString(),\n  suppressed: withinWindow ? suppressedBefore + 1 : 0,\n} }];"
      },
      "id": "a86ce000-87c8-43f3-8d68-1bc847dd9bfb",
