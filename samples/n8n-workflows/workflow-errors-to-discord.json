    {
      "parameters": {},
      "id": "19499ef9-716c-406c-bbf2-563a81a8d9a7",
      "name": "Workflow failed",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Builds the Discord text + a dedupe key (workflow + node + normalised message).\nconst BASE_URL = 'https://n8n.example.com';\nconst MAX_MSG = 300;\n\nconst d = $input.first().json;\nconst wf = d.workflow || {};\nconst ex = d.execution || null;\nconst trg = d.trigger || null;\nconst err = (ex && ex.error) || (trg && trg.error) || {};\n\nconst wfId = String(wf.id || '');\nconst wfName = wf.name || '(bez nazwy)';\nconst nodeName = (ex && ex.lastNodeExecuted) || (err.node && err.node.name) || (trg ? 'trigger' : '?');\nlet message = String(err.message || err.description || 'nieznany błąd').replace(/\\s+/g, ' ').trim();\nif (err.description && err.message && !message.includes(String(err.description))) {\n  message = (message + ' — ' + String(err.description).replace(/\\s+/g, ' ').trim());\n}\nconst short = message.length > MAX_MSG ? message.slice(0, MAX_MSG - 1) + '…' : message;\n\nconst link = ex && ex.id\n  ? BASE_URL + '/workflow/' + wfId + '/executions/' + ex.id\n  : BASE_URL + '/workflow/' + wfId;\n\n// numbers/ids vary between runs of the same failure -> strip them from the key\nconst normalised = message.toLowerCase().replace(/[0-9a-f]{8,}/g, '#').replace(/\\d+/g, '#').slice(0, 160);\nconst alertKey = (wfId + '|' + nodeName + '|' + normalised).slice(0, 250);\n\nconst lines = [\n  '⚠️ **Błąd workflowu:** ' + wfName,\n  '**Węzeł:** ' + nodeName + (trg ? ' (wyzwalacz)' : ''),\n  '**Błąd:** ' + short,\n  '**Wykonanie:** <' + link + '>',\n];\n\nreturn [{ json: { alert_key: alertKey, workflow_id: wfId, content: lines.join('\\n').slice(0, 1900) } }];"
      },
      "id": "6d90a9dc-4e59-4ae5-bd5d-f53d45730a84",
      "name": "Build alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        304
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
