 void	CancelJob(int sig);
 void	OutputLine(ppd_file_t *ppd, cups_page_header2_t *header, int y);
 void	GDXCompress(unsigned char *line, int length, int row);
+void	GDXPace(size_t bytes);
+
+/*
+ * Output pacing: some GoDEX network interfaces (e.g. G330 on port 9100)
+ * silently drop graphic data when it arrives at full LAN speed, which
+ * prints as blank horizontal bands. Flush and pause every GDX_PACE_CHUNK
+ * bytes. GDX_PACE_US=0 in the environment disables pacing.
+ */
+#define GDX_PACE_CHUNK	512
+#define GDX_PACE_US	25000
+
+void
+GDXPace(size_t bytes)
+{
+  static size_t pending = 0;
+  static long   pause_us = -1;
+
+  if (pause_us < 0) {
+    const char *env = getenv("GDX_PACE_US");
+    pause_us = env ? atol(env) : GDX_PACE_US;
+  }
+  if (pause_us == 0)
+    return;
+  pending += bytes;
+  if (pending >= GDX_PACE_CHUNK) {
+    fflush(stdout);
+    usleep((useconds_t)pause_us);
+    pending = 0;
+  }
+}
 
 
